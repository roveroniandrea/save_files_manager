{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Save Files Manager",
  "version": "0.2.0",
  "identifier": "com.savefilesmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Save Files Manager",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Andrea Roveroni",
    "copyright": "© 2026 Andrea Roveroni",
    "category": "Utility",
    "shortDescription": "Per-game save profiles for games with a single save slot",
    "longDescription": "Keeps separate save profiles per game (e.g. one per person) and swaps the game's save folders to the selected profile, with automatic backups and rollback.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Italian"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBN0NCRTkzNDFGNDM1QjYKUldTMk5mUkJrNzU4MnNJNGZmY3pDZWxvMXZtZkp5elNKOFp5dHY5WTkyS2Y0a29nVWVnUFhTc0cK",
      "endpoints": [
        "https://github.com/roveroniandrea/save_files_manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
